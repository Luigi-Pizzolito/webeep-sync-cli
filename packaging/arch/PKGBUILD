# SPDX-License-Identifier: MIT
#
# Packages webeep-sync-cli for Arch Linux from the checkout this file lives in.
# The repository is private, so makepkg never fetches anything itself: it takes
# the HEAD commit of your clone and builds that copy in isolation.
#
#   git clone https://github.com/Luigi-Pizzolito/webeep-sync-cli
#   cd webeep-sync-cli/packaging/arch
#   makepkg -si

pkgname=webeep-sync-cli
pkgrel=1
pkgdesc='Keep WeBeep (webeep.polimi.it) course files synced locally, rsync style'
arch=('x86_64' 'aarch64')
url='https://github.com/Luigi-Pizzolito/webeep-sync-cli'
license=('MIT')
makedepends=('go' 'git')
source=()
noextract=()
# The binary is linked with -s -w, so there are no debug symbols to package.
options=('!debug')

# Repository root: two directories above this file.
_repo="$(readlink -e "$startdir/../..")"

# The version follows the newest tag in the checkout, so the package cannot
# claim a version the source is not.
_tag="$(git -C "$_repo" describe --tags --abbrev=0 2>/dev/null || true)"
pkgver="${_tag#v}"
pkgver="${pkgver//[!0-9A-Za-z_.]/.}"
[[ -z "$pkgver" ]] && pkgver=0

# Version string compiled into the binary, e.g. v0.1 or v0.1-3-gabcdef.
_stamp() { git -C "$_repo" describe --tags --always 2>/dev/null || echo dev; }

prepare() {
	mkdir -p "$srcdir/src"
	git -C "$_repo" archive HEAD | tar -x -C "$srcdir/src"
}

build() {
	cd "$srcdir/src" || return 1
	export GOFLAGS='-trimpath -buildvcs=false'
	export CGO_ENABLED=0
	go build -ldflags "-s -w -X main.version=$(_stamp)" -o "$srcdir/$pkgname" .
}

check() {
	cd "$srcdir/src" || return 1
	export GOFLAGS='-trimpath -buildvcs=false'
	go test ./...
}

package() {
	install -Dm755 "$srcdir/$pkgname" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 "$srcdir/src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$srcdir/src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
